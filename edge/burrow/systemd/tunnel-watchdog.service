[Unit]
Description=Burrow: re-join this room's Tunnel to the Portal when its repeater goes idle
After=network-online.target
ConditionPathExists=/etc/burrow/tunnel.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/burrow/tunnel-watchdog.py
# a run that hangs (DNS during an outage, a stuck nmcli) must not stop the timer for good:
# the timer only fires again after the previous run ends
TimeoutStartSec=240

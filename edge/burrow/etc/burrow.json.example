{
  "edge": "burrow1",
  "room": 1,
  "listen": "0.0.0.0",
  "port": 8080,
  "data_dir": "/data/burrow",
  "www_dir": "/opt/burrow/www",
  "peers": {
    "burrow2": "http://192.168.80.22:8080",
    "burrow3": "http://192.168.80.23:8080"
  },
  "cloud": {
    "url": "https://whs.makerlabkids.com",
    "token_file": "/etc/burrow/cloud.token",
    "live_key_file": "/etc/burrow/live.key",
    "every_s": 60
  },
  "seal_minutes": 15,
  "fsync_s": 30,
  "retain_days": 7,
  "replicate_every_s": 120,
  "sweep": { "enabled": true, "every_s": 300, "first": 100, "last": 249 }
}

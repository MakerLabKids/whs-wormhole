// Wormhole "Surface": the Cloudflare Worker. Wrangler v4.
// Secrets (wrangler secret put): SESSION_SECRET, EDGE_TOKENS, LIVE_KEY, ADMIN_BOOTSTRAP,
// ALERT_URL (optional: an ntfy-style URL that is POSTed alert text, e.g. https://ntfy.sh/<topic>).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wormhole-surface",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },

  // The dashboard SPA lives in web/dash and is served as static assets.
  // The Worker runs first only for the API paths; everything else is a file.
  "assets": {
    "directory": "../../web/dash",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker-first for the API paths AND for extension-less page paths ("/",
    // "/admin", ...), so a logged-in page view can write its visits row;
    // files with an extension (js/css/png) are served straight from assets.
    "run_worker_first": ["/*", "!/*.*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "wormhole", "database_id": "6ab488c5-8f9e-4211-b7a9-49777f31ae93" }
  ],
  "r2_buckets": [
    { "binding": "CASTINGS", "bucket_name": "wormhole-castings" }
  ],
  "vars": {
    "TUNNEL_DOMAIN": "whs.makerlabkids.com",
    "ALERT_BINS": "0"
  },
  // every minute: notice a Burrow that stopped reporting (src/alerts.js watchEdges)
  "triggers": { "crons": ["* * * * *"] },
  "routes": [
    { "pattern": "whs.makerlabkids.com", "custom_domain": true }
  ]
}
